{
  "schemaVersion": 1,
  "id": "ultima",
  "version": "${version}",
  "name": "Ultima",
  "description": "Server-first Minecraft performance mod. Install on a dedicated or integrated server so guests can join with a vanilla client; render modules are optional and client-only. Modules that overlap Sodium, Iris or Lithium switch themselves off.",
  "authors": [
    "adaybekovt-boop"
  ],
  "contact": {
    "homepage": "https://github.com/adaybekovt-boop/Ultima-",
    "sources": "https://github.com/adaybekovt-boop/Ultima-",
    "issues": "https://github.com/adaybekovt-boop/Ultima-/issues"
  },
  "icon": "assets/ultima/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": ["dev.ultima.Ultima"],
    "client": ["dev.ultima.client.UltimaClient"],
    "modmenu": ["dev.ultima.client.settings.UltimaModMenu"]
  },
  "mixins": [
    {
      "config": "ultima.mixins.json",
      "environment": "*"
    },
    {
      "config": "ultima.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=0.19.3",
    "minecraft": "=26.2",
    "java": ">=25",
    "fabric-api": ">=0.156.0+26.2"
  },
  "suggests": {
    "modmenu": "*"
  },
  "custom": {
    "ultima": {
      "gitSha": "${git_sha}"
    }
  }
}
