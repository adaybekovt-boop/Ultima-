{
  "schemaVersion": 1,
  "id": "ultima",
  "version": "${version}",
  "name": "Ultima",
  "description": "Compatibility-first Minecraft performance mod. Install on a dedicated or integrated server so guests can join with a vanilla client; render modules stay client-only.",
  "environment": "*",
  "entrypoints": {
    "main": ["dev.ultima.Ultima"],
    "client": ["dev.ultima.client.UltimaClient"]
  },
  "mixins": [
    {
      "config": "ultima.mixins.json",
      "environment": "*"
    },
    {
      "config": "ultima.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=0.19.3",
    "minecraft": "~26.2",
    "java": ">=25",
    "fabric-api": "*"
  }
}
